# Credentials for the live verification scripts. Copy to .env.local and fill in.
#
#   cp .env.example .env.local
#   chmod 600 .env.local
#   $EDITOR .env.local
#
# Then:
#
#   set -a; source .env.local; set +a
#   npm run verify:auth
#
# .env.local is covered by .gitignore (.env.*), and this file — which carries
# no values — is the one exception that is committed. Never put a real password
# in here, and never behind a GATSBY_ prefix: those are inlined into the public
# bundle at build time.
#
# These are only ever read by scripts/ on this machine. Nothing in packages/
# reads them, and they are not sent anywhere except to Cognito by the same
# aws-amplify/auth client the app itself uses.

PT_USER=
PT_PASSWORD=

# -- The DigitalHome.Cloud core backend (sign-in, docs/adr/0008) ----------------
# PermTek-5 signs in through the DHC user pool and looks it up from the DHC core
# backend at deploy time (backend/scripts/dhc-auth-env.mjs). These two name the
# core's Amplify app and branch; the hosted branches have them as Amplify app
# environment variables. For a sandbox, export them before `npm run dev`.
# (Setting the six DHC_* variables yourself skips the lookup.)
AMPLIFY_BACKEND_APP_ID=
AMPLIFY_BACKEND_APP_BRANCH=
