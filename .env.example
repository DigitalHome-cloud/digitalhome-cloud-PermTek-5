# Credentials for the live verification scripts. Copy to .env.local and fill in.
#
#   cp .env.example .env.local
#   chmod 600 .env.local
#   $EDITOR .env.local
#
# Then:
#
#   set -a; source .env.local; set +a
#   npm run verify:auth
#
# .env.local is covered by .gitignore (.env.*), and this file — which carries
# no values — is the one exception that is committed. Never put a real password
# in here, and never behind a GATSBY_ prefix: those are inlined into the public
# bundle at build time.
#
# These are only ever read by scripts/ on this machine. Nothing in packages/
# reads them, and they are not sent anywhere except to Cognito by the same
# aws-amplify/auth client the app itself uses.

PT_USER=
PT_PASSWORD=

# -- The shared DigitalHome.Cloud user pool (backend/amplify/auth/resource.ts) --
# Read at SYNTH time by `ampx sandbox` / `ampx pipeline-deploy`, never by the
# site. Not secrets, but identifiers of the platform's pool and account: they
# stay out of this public repository. For a sandbox, export them in the shell;
# for the hosted branches, they are Amplify app environment variables.
# How to read them: docs/setup/shared-auth.md
DHC_USER_POOL_ID=
DHC_USER_POOL_CLIENT_ID=
DHC_IDENTITY_POOL_ID=
DHC_AUTH_ROLE_ARN=
DHC_UNAUTH_ROLE_ARN=
DHC_ADMINS_GROUP_ROLE_ARN=
