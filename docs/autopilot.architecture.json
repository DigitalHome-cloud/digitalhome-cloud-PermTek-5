        "label": "The edge reports",
        "focus": [
          "keeper",
          "edge",
          "edgeapi",
          "registry"
        ],
        "note": "The guild's edge sends its care record and the keeper's reactions when they change, at least hourly. Rehearsals send nothing."
      },
      {
        "id": "plan",
        "label": "The cloud plans",
        "focus": [
          "guide",
          "planner",
          "registry",
          "today"
        ],
        "note": "On each report the planner works out what is due on the edge's own date: chores for the person, jobs for the robot."
      },
      {
        "id": "confirm",
        "label": "A person confirms",
        "focus": [
          "today",
          "edgeapi",
          "edge",
          "person",
          "robot"
        ],
        "note": "A Done on a chore goes back to the edge's record. Robot jobs are confirmed on the edge, never from the cloud."
      },
      {
        "id": "rehearsal",
        "label": "Rehearsal stays on the edge",
        "focus": [
          "twin",
          "person",
          "edge"
        ],
        "note": "In a twin rehearsal the edge autopilot plays the person and confirms. Nothing is written back."
      }
    ]
