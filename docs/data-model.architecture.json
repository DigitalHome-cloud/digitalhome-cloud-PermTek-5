    {
      "dot": "cyan",
      "title": "Linked, not copied",
      "items": [
        "The home and its postal area stay in DigitalHome.Cloud",
        "Crops are IRIs into one shared library",
        "Positions are metres inside an area, never geographic"
      ]
    },
    {
      "dot": "rose",
      "title": "Kept safe",
      "items": [
        "Every save carries the version it started from",
        "Shapes refuse a map that does not fit the model",
        "A Webots world or a USD run stage is a view: the map stays the truth"
      ]
