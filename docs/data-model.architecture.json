    "views": [
      {
        "id": "site",
        "label": "A site belongs to a home",
        "focus": [
          "dhome",
          "parea",
          "site",
          "group",
          "edge"
        ],
        "note": "One site per DigitalHome. Its members form the shared group; private groups are optional. The climate is the home's postal area."
      },
      {
        "id": "map",
        "label": "Areas, guilds, beds, cells",
        "focus": [
          "graph",
          "area",
          "guild",
          "bed",
          "cell",
          "plant"
        ],
        "note": "An area holds Perma5Guilds: a bed with its worm box, tank and robot. Beds split into cells; trees stand in the area."
      },
      {
        "id": "crops",
        "label": "One crop library",
        "focus": [
          "cell",
          "plant",
          "crop"
        ],
        "note": "Cells and plants point at crops of the shared library: names in four languages, what a crop needs, how deep and how far apart to sow."
      },
      {
        "id": "year",
        "label": "A bed's year",
        "focus": [
          "bed",
          "period",
          "cell"
        ],
        "note": "A bed's year is split into growing periods and a rest. Each growing period has its plant sets and its target: the cells planned in it."
      },
      {
        "id": "views",
        "label": "Views, not truth",
        "focus": [
          "edge",
          "runstage",
          "graph"
        ],
        "note": "An edge writes a run as an OpenUSD stage to replay or film. It is made from the map and the run, never stored back."
      }
    ]
  },
