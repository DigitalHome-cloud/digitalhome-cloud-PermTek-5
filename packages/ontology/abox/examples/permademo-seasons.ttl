@prefix perma: <https://permaculture.digitalhome.cloud/ontology#> .
@prefix id:    <https://permaculture.digitalhome.cloud/id/> .

# Season calendar of PermaDemo: when each crop is sown, planted out and harvested on this site.
# Basis: general practice, temperate lowland, last frost mid-April (invented site). Every window starts 'to confirm'.

[] a perma:SeasonWindow ; perma:atSite id:site-permademo ; perma:forCrop id:crop-courgette ;
   perma:activity perma:SowIndoors ; perma:fromMonth 4 ; perma:toMonth 4 ;
   perma:confirmation perma:ToConfirm ; perma:basis "general practice, temperate lowland, last frost mid-April (invented site)" .
[] a perma:SeasonWindow ; perma:atSite id:site-permademo ; perma:forCrop id:crop-courgette ;
   perma:activity perma:PlantOut ; perma:fromMonth 5 ; perma:toMonth 6 ;
   perma:confirmation perma:ToConfirm ; perma:basis "general practice, temperate lowland, last frost mid-April (invented site)" .
