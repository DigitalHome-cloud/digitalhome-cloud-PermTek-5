@prefix perma: <https://permaculture.digitalhome.cloud/ontology#> .
@prefix id:    <https://permaculture.digitalhome.cloud/id/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dwc:   <http://rs.tdwg.org/dwc/terms/> .

# The shared crop library, v0.1: the crops of the first recipe. The same for
# every project; when and where they grow is each site's calendar.
# Names: English, French, German and Latin (rdfs:label @en @fr @de @la). GBIF links are in
# crops-gbif.ttl (generated by tools/gbif_link.py).
# keeps: the ways each part can be kept and for how many months after the harvest (approximate).

id:crop-courgette a perma:Crop ;
    rdfs:label "Courgette"@en , "Zucchini"@de , "Courgette"@fr , "Cucurbita pepo"@la ;
    rdfs:comment "The courgette group of the species; pumpkins and pâtissons are the same species and cross with it."@en ;
    dwc:scientificName "Cucurbita pepo" ;
    perma:seedSaving [ perma:propagation perma:FromSeed ; perma:lifeCycle perma:Annual ; perma:pollination perma:InsectPollinated ;
        perma:crossesWith "every Cucurbita pepo: other courgettes, pumpkins, pâtissons, ornamental gourds" ;
        perma:isolationM 800.0 ; perma:seedViabilityYears 6 ; perma:selfSows false ;
        rdfs:comment "Or hand-pollinate a female flower and close it. Seed from a fruit left to mature on the plant about 8 weeks past eating size."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Fruit ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Frozen ; perma:storageMonths 8 ] ] .

id:crop-onion a perma:Crop ;
    rdfs:label "Onion"@en , "Zwiebel"@de , "Oignon"@fr , "Allium cepa"@la ;
    dwc:scientificName "Allium cepa" ;
    perma:seedSaving [ perma:propagation perma:FromSeed ; perma:lifeCycle perma:Biennial ; perma:pollination perma:InsectPollinated ;
        perma:crossesWith "every Allium cepa, including shallots" ;
        perma:isolationM 1000.0 ; perma:seedViabilityYears 2 ; perma:selfSows false ;
        rdfs:comment "Keep the best bulbs over winter, replant them in spring; seed heads ripen in summer of the second year. Seed is short-lived: renew every year or two."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Bulb ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Cellar ; perma:storageMonths 6 ] ] .

id:crop-sweet-pepper a perma:Crop ;
    rdfs:label "Sweet pepper"@en , "Paprika"@de , "Poivron"@fr , "Capsicum annuum"@la ;
    rdfs:comment "The sweet (non-pungent) group of the species; chillies are the same species."@en ;
    dwc:scientificName "Capsicum annuum" ;
    perma:seedSaving [ perma:propagation perma:FromSeed ; perma:lifeCycle perma:Annual ; perma:pollination perma:SelfPollinating ;
        perma:crossesWith "every Capsicum annuum, chillies included (insects cross some flowers)" ;
        perma:isolationM 50.0 ; perma:seedViabilityYears 3 ; perma:selfSows false ;
        rdfs:comment "Seed from fully ripe (coloured) fruit; bag a few flowers if chillies grow nearby."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Fruit ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Frozen ; perma:storageMonths 8 ] , [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

id:crop-dill a perma:Crop ;
    rdfs:label "Dill"@en , "Dill"@de , "Aneth"@fr , "Anethum graveolens"@la ;
    dwc:scientificName "Anethum graveolens" ;
    perma:seedSaving [ perma:propagation perma:FromSeed ; perma:lifeCycle perma:Annual ; perma:pollination perma:InsectPollinated ;
        perma:crossesWith "other dill varieties" ;
        perma:isolationM 800.0 ; perma:seedViabilityYears 3 ; perma:selfSows true ;
        rdfs:comment "Let a few plants flower and dry on the stem; the same seed is the spice. Self-sows readily."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Leaf ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Dried ; perma:storageMonths 12 ] , [ perma:method perma:Frozen ; perma:storageMonths 6 ] ] ,
                 [ perma:part perma:Seed ; perma:keeps [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

id:crop-white-mustard a perma:Crop ;
    rdfs:label "White mustard"@en , "Weißer Senf"@de , "Moutarde blanche"@fr , "Sinapis alba"@la ;
    rdfs:comment "Yellow mustard seed (graines de moutarde jaune) for pickles."@en ;
    dwc:scientificName "Sinapis alba" ;
    perma:seedSaving [ perma:propagation perma:FromSeed ; perma:lifeCycle perma:Annual ; perma:pollination perma:InsectPollinated ;
        perma:crossesWith "other Sinapis alba" ;
        perma:isolationM 800.0 ; perma:seedViabilityYears 4 ; perma:selfSows true ;
        rdfs:comment "The seed harvest for the kitchen is also the seed for next year: keep some back."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Seed ; perma:keeps [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

id:crop-black-pepper a perma:Crop ;
    rdfs:label "Black pepper"@en , "Schwarzer Pfeffer"@de , "Poivre noir"@fr , "Piper nigrum"@la ;
    rdfs:comment "A tropical vine: in the library so recipes can name it, but no temperate site has a calendar for it."@en ;
    dwc:scientificName "Piper nigrum" ;
    perma:yields [ perma:part perma:Fruit ; perma:keeps [ perma:method perma:Dried ; perma:storageMonths 24 ] ] .

# ------------------------------------------------------------ added 2026-10-09: the second set of recipes

id:crop-tomato a perma:Crop ;
    rdfs:label "Tomato"@en , "Tomate"@de , "Tomate"@fr , "Solanum lycopersicum"@la ;
    dwc:scientificName "Solanum lycopersicum" ;
    perma:seedSaving [ perma:propagation perma:FromSeed ;
        perma:lifeCycle perma:Annual ;
        perma:pollination perma:SelfPollinating ;
        perma:crossesWith "other tomatoes, rarely (potato-leaf and old varieties more)" ;
        perma:isolationM 3.0 ;
        perma:seedViabilityYears 5 ;
        perma:selfSows false ;
        rdfs:comment "Seed from fully ripe fruit of open-pollinated varieties (not F1); ferment the pulp a few days, rinse, dry."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Fruit ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Bottled ; perma:storageMonths 12 ] , [ perma:method perma:Frozen ; perma:storageMonths 8 ] , [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

id:crop-aubergine a perma:Crop ;
    rdfs:label "Aubergine"@en , "Aubergine"@de , "Aubergine"@fr , "Solanum melongena"@la ;
    dwc:scientificName "Solanum melongena" ;
    perma:seedSaving [ perma:propagation perma:FromSeed ;
        perma:lifeCycle perma:Annual ;
        perma:pollination perma:SelfPollinating ;
        perma:crossesWith "other aubergines (insects cross some flowers)" ;
        perma:isolationM 15.0 ;
        perma:seedViabilityYears 5 ;
        perma:selfSows false ;
        rdfs:comment "Leave a fruit on the plant until it turns dull yellow-brown; scrape out the seed."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Fruit ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Frozen ; perma:storageMonths 6 ] ] .

id:crop-garlic a perma:Crop ;
    rdfs:label "Garlic"@en , "Knoblauch"@de , "Ail"@fr , "Allium sativum"@la ;
    dwc:scientificName "Allium sativum" ;
    perma:seedSaving [ perma:propagation perma:FromCloves ;
        perma:lifeCycle perma:Perennial ;
        perma:selfSows false ;
        rdfs:comment "Grown as an annual: keep the biggest, healthiest bulbs and replant their outer cloves in autumn."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Bulb ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Cellar ; perma:storageMonths 8 ] ] .

id:crop-basil a perma:Crop ;
    rdfs:label "Basil"@en , "Basilikum"@de , "Basilic"@fr , "Ocimum basilicum"@la ;
    dwc:scientificName "Ocimum basilicum" ;
    perma:seedSaving [ perma:propagation perma:FromSeed , perma:FromCuttings ;
        perma:lifeCycle perma:Annual ;
        perma:pollination perma:InsectPollinated ;
        perma:crossesWith "other basils (Ocimum basilicum varieties)" ;
        perma:isolationM 50.0 ;
        perma:seedViabilityYears 5 ;
        perma:selfSows false ;
        rdfs:comment "Let a few plants flower; cut the dry flower stems and rub out the seed."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Leaf ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Frozen ; perma:storageMonths 6 ] , [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

id:crop-thyme a perma:Crop ;
    rdfs:label "Thyme"@en , "Thymian"@de , "Thym"@fr , "Thymus vulgaris"@la ;
    rdfs:comment "An evergreen perennial: leaves can be picked all year, best for drying just before flowering."@en ;
    dwc:scientificName "Thymus vulgaris" ;
    perma:seedSaving [ perma:propagation perma:FromCuttings , perma:ByDivision , perma:FromSeed ;
        perma:lifeCycle perma:Perennial ;
        perma:pollination perma:InsectPollinated ;
        perma:crossesWith "other Thymus vulgaris" ;
        perma:seedViabilityYears 3 ;
        perma:selfSows false ;
        rdfs:comment "Easiest kept by cuttings or division of a good plant; renew every 4-5 years when it gets woody."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Leaf ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

id:crop-rosemary a perma:Crop ;
    rdfs:label "Rosemary"@en , "Rosmarin"@de , "Romarin"@fr , "Salvia rosmarinus"@la ;
    rdfs:comment "Formerly Rosmarinus officinalis. Evergreen: leaves all year."@en ;
    dwc:scientificName "Salvia rosmarinus" ;
    perma:seedSaving [ perma:propagation perma:FromCuttings ;
        perma:lifeCycle perma:Perennial ;
        perma:selfSows false ;
        rdfs:comment "Take cuttings of non-flowering shoots in late summer."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Leaf ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

id:crop-bay-laurel a perma:Crop ;
    rdfs:label "Bay laurel"@en , "Echter Lorbeer"@de , "Laurier-sauce"@fr , "Laurus nobilis"@la ;
    rdfs:comment "Evergreen shrub or small tree: leaves all year."@en ;
    dwc:scientificName "Laurus nobilis" ;
    perma:seedSaving [ perma:propagation perma:FromCuttings ;
        perma:lifeCycle perma:Perennial ;
        perma:selfSows false ;
        rdfs:comment "Semi-ripe cuttings in summer, or suckers from the base."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Leaf ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

id:crop-white-cabbage a perma:Crop ;
    rdfs:label "White cabbage"@en , "Weißkohl"@de , "Chou blanc"@fr , "Brassica oleracea"@la ;
    rdfs:comment "The white headed cabbage group (capitata) of the species; kale, broccoli and cauliflower are the same species and cross with it."@en ;
    dwc:scientificName "Brassica oleracea" ;
    perma:seedSaving [ perma:propagation perma:FromSeed ;
        perma:lifeCycle perma:Biennial ;
        perma:pollination perma:InsectPollinated ;
        perma:crossesWith "every Brassica oleracea: other cabbages, kale, broccoli, cauliflower, kohlrabi" ;
        perma:isolationM 800.0 ;
        perma:seedViabilityYears 5 ;
        perma:selfSows false ;
        rdfs:comment "Keep the best heads over winter, replant in spring; seed pods ripen in summer of the second year."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Leaf ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Cellar ; perma:storageMonths 4 ] , [ perma:method perma:Fermented ; perma:storageMonths 6 ] ] .

id:crop-caraway a perma:Crop ;
    rdfs:label "Caraway"@en , "Kümmel"@de , "Carvi"@fr , "Carum carvi"@la ;
    dwc:scientificName "Carum carvi" ;
    perma:seedSaving [ perma:propagation perma:FromSeed ;
        perma:lifeCycle perma:Biennial ;
        perma:pollination perma:InsectPollinated ;
        perma:crossesWith "other caraway" ;
        perma:isolationM 800.0 ;
        perma:seedViabilityYears 2 ;
        perma:selfSows true ;
        rdfs:comment "Flowers in its second year; the seed for the kitchen is the seed for sowing."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Seed ; perma:keeps [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

id:crop-apple a perma:Crop ;
    rdfs:label "Apple"@en , "Apfel"@de , "Pommier (pomme)"@fr , "Malus domestica"@la ;
    dwc:scientificName "Malus domestica" ;
    perma:seedSaving [ perma:propagation perma:ByGrafting ;
        perma:lifeCycle perma:Perennial ;
        perma:pollination perma:InsectPollinated ;
        perma:crossesWith "other apple and crab apple varieties (needed: most apples need a pollinator variety nearby)" ;
        perma:selfSows false ;
        rdfs:comment "Apples do not come true from seed: keep a variety by grafting scions onto a rootstock in late winter."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Fruit ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Cellar ; perma:storageMonths 5 ] , [ perma:method perma:Bottled ; perma:storageMonths 12 ] , [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .

id:crop-walnut a perma:Crop ;
    rdfs:label "Walnut"@en , "Walnuss"@de , "Noyer (noix)"@fr , "Juglans regia"@la ;
    rdfs:comment "The green fruit (late June) is for vin de noix; the ripe nut (autumn) is the kernel, stored dry."@en ;
    dwc:scientificName "Juglans regia" ;
    perma:seedSaving [ perma:propagation perma:ByGrafting , perma:FromSeed ;
        perma:lifeCycle perma:Perennial ;
        perma:pollination perma:WindPollinated ;
        perma:crossesWith "other walnuts" ;
        perma:seedViabilityYears 1 ;
        perma:selfSows false ;
        rdfs:comment "Named varieties (Franquette) are grafted; seedlings vary. Nuts for sowing must not dry out."@en ;
        perma:confirmation perma:ToConfirm ; perma:basis "general growing and seed-saving guidance, approximate" ] ;
    perma:yields [ perma:part perma:Fruit ; perma:keeps [ perma:method perma:Fresh ; perma:storageMonths 0 ] , [ perma:method perma:Macerated ; perma:storageMonths 36 ] ] ,
                 [ perma:part perma:Seed ; perma:keeps [ perma:method perma:Dried ; perma:storageMonths 12 ] ] .
